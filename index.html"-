window.plM=id=>{const m=members.find(x=>x.id==id);cm();const o=document.createElement("div");o.className="mo";o.id="mo";o.onclick=e=>{if(e.target===o)cm()};
 o.innerHTML=`<div class="mc" style="padding:18px"><b style="font-size:18px">Plan for ${esc(m.name)}</b><div class="mu" style="margin:4px 0 8px">Write a diet or workout plan. The member sees it in the app.</div><textarea id="plt" rows="10" maxlength="3000" placeholder="Morning: ...&#10;Pre-workout: ...&#10;Post-workout: ...">${esc(m.plan||"")}</textarea><button style="width:100%" onclick="plS('${id}')">Save plan</button><button class="g" style="width:100%" onclick="cm()">Cancel</button></div>`;document.body.appendChild(o)};
window.plS=async id=>{const m=members.find(x=>x.id==id),t=$("#plt").value.trim();try{await updateDoc(doc(db,"members",id),{plan:t,planAt:today()});m.plan=t;m.planAt=today();cm();list()}catch(e){alert("Error: "+(e.code||e.message))}};
window.rp=async id=>{const m=members.find(x=>x.id==id),pn=prompt("New PIN (4 digits)");if(!pn)return;if(pn.length<4)return alert("PIN must be at least 4 digits");
 const rv=(m.rv||0)+1;if(rv>3)return alert("Reset limit (3) reached. Delete this user in Firebase > Authentication and add the member again.");
 try{const c=await createUserWithEmailAndPassword(auth2,mail(m.phone,rv),pw(pn));await signOut(auth2);
  const data={...m};delete data.id;await setDoc(doc(db,"members",c.user.uid),{...data,rv});await deleteDoc(doc(db,"members",id));alert("PIN reset ✅");admin()}
 catch(e){alert("Error: "+(e.code||e.message))}};
window.cp=async()=>{const n=prompt("New PIN (4 digits)");if(!n)return;if(n.length<4)return alert("PIN must be at least 4 digits");
 try{await updatePassword(auth.currentUser,pw(n));alert("PIN changed ✅")}catch(e){alert(e.code=="auth/requires-recent-login"?"Please log out, log in again, then change your PIN":"Error: "+(e.code||e.message))}};
window.apr=async id=>{const r=reqs.find(x=>x.id==id),m=r&&members.find(x=>x.id==r.uid);if(!m)return alert("Member not found");
 if(!confirm("Did ₹"+r.amount+" arrive in UPI? Check UTR "+r.utr+" in your UPI app."))return;
 try{const base=diff(m.expiry)<0?today():m.expiry;m.expiry=addD(base,30*r.months);await updateDoc(doc(db,"members",r.uid),{expiry:m.expiry});
  const p={uid:r.uid,name:r.name,amount:r.amount,mode:"UPI",months:r.months,date:today()};await addDoc(collection(db,"payments"),p);pays.push(p);
  await updateDoc(doc(db,"payreq",id),{status:"approved"});reqs=reqs.filter(x=>x.id!=id);draw()}catch(e){alert("Error: "+(e.code||e.message))}};
window.rej=async id=>{if(!confirm("Reject this request?"))return;try{await updateDoc(doc(db,"payreq",id),{status:"rejected"});reqs=reqs.filter(x=>x.id!=id);draw()}catch(e){alert("Error: "+(e.code||e.message))}};
</script></body></html>
